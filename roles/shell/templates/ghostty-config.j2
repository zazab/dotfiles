font-family = "FiraMono Nerd Font Propo"
theme = Dracula

background-opacity = 0.95
unfocused-split-opacity = 0.5
shell-integration = zsh
mouse-hide-while-typing = true
scrollback-limit = 1000000
window-save-state = always
copy-on-select = clipboard

# Keep the right Option key available for macOS character input, while making
# the left key emit Alt/Meta sequences for terminal and Ghostty shortcuts.
macos-option-as-alt = left

config-file = keybindings
