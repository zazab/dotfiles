font-family = "FiraMono Nerd Font Propo"
theme = Dracula
# Ghostty launched from the Dock does not inherit the login-shell PATH.
# Start tmux through login zsh so tmux and its plugins receive the normal
# user environment (including Homebrew) without a duplicate PATH declaration.
command = direct:/bin/zsh -lc "exec {{ terminal_multiplexer_program }}"

background-opacity = 0.95
unfocused-split-opacity = 0.5
shell-integration = zsh
mouse-hide-while-typing = true
scrollback-limit = 1000000
window-save-state = always
copy-on-select = clipboard

# Keep the right Option key available for macOS character input, while making
# the left key emit Alt/Meta sequences for tmux shortcuts.
macos-option-as-alt = left

config-file = keybindings
