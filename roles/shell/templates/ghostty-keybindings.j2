keybind = ctrl+n=new_window

keybind = super+r=reload_config
keybind = super+shift+j=write_scrollback_file:paste

# Cmd+Option+1..9 selects tmux panes 1..9; Cmd+Option+0 selects pane 10.
# These private sequences map to tmux User0..User9, distinct from Option+number
# (which tmux uses for window selection).
keybind = super+alt+1=text:\x1b[57361~
keybind = super+alt+2=text:\x1b[57362~
keybind = super+alt+3=text:\x1b[57363~
keybind = super+alt+4=text:\x1b[57364~
keybind = super+alt+5=text:\x1b[57365~
keybind = super+alt+6=text:\x1b[57366~
keybind = super+alt+7=text:\x1b[57367~
keybind = super+alt+8=text:\x1b[57368~
keybind = super+alt+9=text:\x1b[57369~
keybind = super+alt+0=text:\x1b[57370~
