# CAPI aliases
capi_alias () {
    echo 'alias kgm="$kctl_binary get machine"'
    echo 'alias kgpm="$kctl_binary get platformmachine"'
    echo 'alias kgvm="$kctl_binary get virtualmachine"'
    echo '## machine deployments & c-p'
    echo 'alias kgmd="$kctl_binary get machinedeployment"'
    echo 'alias kgkac="$kctl_binary get kubeadmcontrolplane"'
    echo 'alias kgkact="$kctl_binary get kubeadmconfigtemplate"'
    echo '## Clusters'
    echo 'alias kgclu="$kctl_binary get cluster"'
    echo 'alias kgaclu="$kctl_binary get infracluster"'
    echo 'alias kgcc="$kctl_binary get clusterclass"'
    echo '## Label-selectors'
    echo 'alias -g CL-cluster="cluster.x-k8s.io/cluster-name="'
    echo 'alias -g CL-control-plane="cluster.x-k8s.io/control-plane"'
}


