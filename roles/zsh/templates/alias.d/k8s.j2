# Cluster API aliases
capi_get_cluster_master_machines () {
    cluster="$1"

    $kctl_binary get machine -l "cluster.x-k8s.io/control-plane,cluster.x-k8s.io/cluster-name=$cluster"
}

capi_get_multiple_cluster_master_machines () {
    clusters="${(j:, :)@}"
    
    $kctl_binary get machine -l "cluster.x-k8s.io/control-plane,cluster.x-k8s.io/cluster-name in ($clusters)"
}
