#!/usr/bin/env bash

set -o pipefail

if pgrep -f '/sing-box run -c ' >/dev/null 2>&1; then
  printf 'VPN sing-box\n'
elif command -v scutil >/dev/null 2>&1; then
  scutil --nc list 2>/dev/null |
    awk -F '"' '/\(Connected\).*VPN/ { print "VPN " $2; exit }'
elif command -v nmcli >/dev/null 2>&1; then
  nmcli --terse --fields NAME,TYPE connection show --active 2>/dev/null |
    awk -F ':' '$2 == "vpn" { print "VPN " $1; exit }'
fi
